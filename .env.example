# URL di base dell'API FitTrack (usata da lib/api.ts)
# In sviluppo di default è http://localhost:3000/api
#   - simulatore iOS:  http://localhost:3000/api
#   - emulatore Android: http://10.0.2.2:3000/api
#   - device fisico: http://<IP-del-pc>:3000/api  (stessa rete Wi-Fi)
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# --- Supabase Auth (usato da lib/supabase.ts per i token Bearer) ---
# Locale: valori della Supabase CLI (`npx supabase status -o env`).
# In cloud: Settings → API → Project URL e anon/publishable key.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Postgres — pooler Supabase (runtime Prisma, porta 6543 in cloud, ?pgbouncer=true)
# Locale: il pooler è Supavisor (external_id = "pooler-dev" nel nome utente)
DATABASE_URL="postgresql://postgres.pooler-dev:postgres@127.0.0.1:54329/postgres?pgbouncer=true"
# Postgres — connessione diretta (solo migrazioni Prisma, porta 5432 in cloud)
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# --- Variabili d'ambiente runtime (Render Web Service) ---
# Solo nomi: i valori vanno impostati nel dashboard di Render, non qui.
#   DATABASE_URL        obbligatoria — pooler Supabase cloud (porta 6543, ?pgbouncer=true)
#   SUPABASE_JWT_SECRET obbligatoria — secret JWT HS256 del progetto (chiavi simmetriche)
#   SUPABASE_JWKS_URL   obbligatoria — JWKS del progetto (verifica token utente ES256)
#   ALLOWED_ORIGIN      obbligatoria — origin abilitate al CORS, separate da virgola
#   GEMINI_API_KEY      obbligatoria per le feature AI (chiave Google AI Studio)
#   RESEND_API_KEY      in seguito — email transazionali
# Fornite/assenti di default:
#   PORT                iniettata da Render (il server ascolta su process.env.PORT)
#   DIRECT_URL          solo per `prisma migrate deploy` in fase di build, non a runtime

# --- Google Gemini (usato SOLO da src/api/lib/gemini.ts, lato server) ---
# Chiave di Google AI Studio (https://aistudio.google.com/apikey).
# MAI una variabile EXPO_PUBLIC_*: queste finiscono nel bundle del client e
# la chiave deve restare sul backend. Senza chiave le route /api/ai/* 
# rispondono 503 GEMINI_NOT_CONFIGURED (il resto dell'app funziona).
# GEMINI_API_KEY=

# Override opzionali (default già validi; li usa il test con un Gemini mock):
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_API_BASE=https://generativelanguage.googleapis.com
# GEMINI_TIMEOUT_MS=45000
