# URL di base dell'API FitTrack (usata da lib/api.ts)
# In sviluppo di default è http://localhost:3000/api
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Postgres — pooler Supabase (runtime Prisma, porta 6543 in cloud, ?pgbouncer=true)
# Locale: il pooler è Supavisor (external_id = "pooler-dev" nel nome utente)
DATABASE_URL="postgresql://postgres.pooler-dev:postgres@127.0.0.1:54329/postgres?pgbouncer=true"
# Postgres — connessione diretta (solo migrazioni Prisma, porta 5432 in cloud)
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# --- Variabili d'ambiente runtime (Render Web Service) ---
# Solo nomi: i valori vanno impostati nel dashboard di Render, non qui.
#   DATABASE_URL        obbligatoria — pooler Supabase cloud (porta 6543, ?pgbouncer=true)
#   SUPABASE_JWT_SECRET obbligatoria — secret JWT HS256 del progetto (verifica token Auth)
#   ALLOWED_ORIGIN      obbligatoria — origin abilitate al CORS, separate da virgola
#   GEMINI_API_KEY      in seguito — feature AI (generazione scheda/dieta, foto pasti)
#   RESEND_API_KEY      in seguito — email transazionali
# Fornite/assenti di default:
#   PORT                iniettata da Render (il server ascolta su process.env.PORT)
#   DIRECT_URL          solo per `prisma migrate deploy` in fase di build, non a runtime
